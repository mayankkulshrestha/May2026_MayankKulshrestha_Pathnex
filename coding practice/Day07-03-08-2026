2. Kubernetes: Deployment 2 replicas

apiVersion: apps/v1
kind: Deployment
metadata:
  name: pathnex-deployment
spec:
  replicas: 2
  selector:
    matchLabels:
      app: pathnexapp
  template:
    metadata:
     labels:
       app: pathnexapp
    spec:
      containers:
        - name: app
          image: nginx:latest
          ports:
           - containerPort: 80

