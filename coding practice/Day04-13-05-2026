## 🔹 Terraform Task — Create EC2 (c5.xlarge)

provider "aws"{
    region = "us-east-1"
}
resource "aws_instance" "pathnexec2"{
    ami         = "ami-0abcd1234abcd1234"
    instace_type = "c5.large"

    tags = {
        name = "pathnex-ec2"
    }
}


## 🔹 Kubernetes Task — Create Nginx Pod


apiversion: v1
kind: Pod
metadata:
    name: pathnex-pod
spec:
  containers:
    -name: web
    image: nginx:latest
    ports:
        - containerPort:80